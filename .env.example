# JalMarg (जलमार्ग) Root Environment Configuration Template
# Region: ap-south-1 (Asia Pacific - Mumbai)

AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Local Development & Emulation (LocalStack)
LOCALSTACK_ENDPOINT=http://localhost:4566
USE_LOCALSTACK=true

# Storage & Search Endpoints
OPENSEARCH_ENDPOINT=http://localhost:9200
DYNAMODB_ENDPOINT=http://localhost:4566
S3_ENDPOINT=http://localhost:4566

# Service Bus & Messaging
EVENTBRIDGE_BUS_NAME=jalmarg-event-bus
SQS_INCIDENT_QUEUE_URL=http://localhost:4566/000000000000/jalmarg-incident-priority-queue

# AI & LLM Service Keys (Optional for local mocks, required for live deployment)
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Frontend Configuration
VITE_API_BASE_URL=/api
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_DEFAULT_CITY=bengaluru
VITE_DEFAULT_LAT=12.9716
VITE_DEFAULT_LNG=77.5946
