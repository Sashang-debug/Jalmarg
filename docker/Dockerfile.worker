# ==============================================================================
# JalMarg OSINT & Background Scraper Worker Container
# Build locally with Finch: finch build -t jalmarg-scraper:latest -f docker/Dockerfile.worker .
# Or with Docker: docker build -t jalmarg-scraper:latest -f docker/Dockerfile.worker .
# ==============================================================================

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AWS_DEFAULT_REGION=ap-south-1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy application logic
COPY agents /app/agents
COPY backend/src /app/src

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import boto3; print('Worker healthy')" || exit 1

CMD ["python", "-m", "agents.osint_scraper_agent"]
