{
  "Comment": "Validate a persisted citizen observation and mark it for operator review. No image-depth inference or automatic civic dispatch.",
  "StartAt": "PrepareEvidenceReview",
  "States": {
    "PrepareEvidenceReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${ProcessReportArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "End": true
    }
  }
}
